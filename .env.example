# =====================================================================
# NEXUS-GUARD Enterprise Environment Variables Template
# 민감 정보(API 키, 토큰, 비밀번호)는 절대 GitHub에 커밋하지 마십시오.
# 본 파일을 복사하여 '.env' 로 저장한 후 본인의 환경에 맞는 키를 입력하십시오.
# =====================================================================

# 1. AI-XDR 엔진 API 키 (클라우드 LLM 추론)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# 로컬 오프라인 LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 2. 감시 대상 웹 포털 및 DB 연동 설정
GUARD_TARGET_URL=http://127.0.0.1:5070
GUARD_TARGET_HOST=127.0.0.1
GUARD_TARGET_PORT=5070

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nexus_enterprise
DB_USER=nexus_guard_user
DB_PASSWORD=your_secure_db_password_here

# 3. 경계 방화벽 (pfSense) 연동
PFSENSE_ENABLED=false
PFSENSE_HOST=192.168.3.10
PFSENSE_WEBGUI_PORT=443
PFSENSE_ALIAS_NAME=NEXUS_DROP_LIST
PFSENSE_API_TOKEN=your_pfsense_api_token_here

# 4. 중앙 보안관제 SIEM (Graylog GELF)
GRAYLOG_ENABLED=false
GRAYLOG_HOST=192.168.3.15
GRAYLOG_GELF_UDP_PORT=12201
GRAYLOG_STREAM_NAME=NEXUS_SECURITY_EVENTS

# 5. 엔드포인트 무결성 감시 (Wazuh)
WAZUH_ENABLED=false
WAZUH_MANAGER_HOST=192.168.3.15
WAZUH_MANAGER_PORT=1514
WAZUH_AGENT_ID=001
WAZUH_AGENT_NAME=nexus-guard-host

# 6. SOAR 및 웹훅 자동 대응 (Discord, Slack, n8n)
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
N8N_SOAR_WEBHOOK_URL=http://192.168.3.15:5678/webhook/nexus-incident-auto-defense
